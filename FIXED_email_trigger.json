      "id": "361a5637-eb4b-47df-8306-c558126209e8",
      "name": "Filter Sender3"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const itemData of items) {\n  const item = itemData.json;\n  let senderName = '';\n  let senderEmail = '';\n\n  // Outlook Trigger v1 outputs 'from' as a plain email string or object\n  if (typeof item.from === 'string') {\n    senderEmail = item.from;\n    const namePart = item.from.split('@')[0] || '';\n    senderName = namePart.replace(/[._-]/g, ' ').replace(/\\b\\w/g, c => c.toUpperCase());\n  } else if (item.from && item.from.emailAddress) {\n    senderEmail = item.from.emailAddress.address || '';\n    senderName = item.from.emailAddress.name || '';\n  }\n\n  // Fallback to sender field\n  if (!senderEmail && item.sender) {\n    if (typeof item.sender === 'string') {\n      senderEmail = item.sender;\n    } else if (item.sender.emailAddress) {\n      senderEmail = item.sender.emailAddress.address || '';\n      senderName = senderName || item.sender.emailAddress.name || '';\n    }\n  }\n\n  const subject = item.subject || '';\n\n  // Get description - strip HTML tags\n  let description = item.bodyPreview || '';\n  if (!description && item.body && item.body.content) {\n    description = item.body.content\n      .replace(/<[^>]*>/g, '')\n      .replace(/&nbsp;/g, ' ')\n      .replace(/&amp;/g, '&')\n      .replace(/\\s+/g, ' ')\n      .trim();\n  }\n\n  results.push({\n    json: {\n      fullName: senderName,\n      email: senderEmail,\n      subject: subject,\n      description: description,\n      requestType: 'Email Support',\n      accountType: 'Customer',\n      messageId: item.id\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
