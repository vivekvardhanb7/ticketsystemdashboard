      "name": "Filter Sender3"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const itemData of items) {\n  const item = itemData.json;\n  let senderName = '';\n  let senderEmail = '';\n\n  if (typeof item.from === 'string') {\n    senderEmail = item.from;\n    const namePart = item.from.split('@')[0] || '';\n    senderName = namePart.replace(/[._-]/g, ' ').replace(/\\b\\w/g, c => c.toUpperCase());\n  } else if (item.from && item.from.emailAddress) {\n    senderEmail = item.from.emailAddress.address || '';\n    senderName = item.from.emailAddress.name || '';\n  }\n\n  if (!senderEmail && item.sender) {\n    if (typeof item.sender === 'string') {\n      senderEmail = item.sender;\n    } else if (item.sender.emailAddress) {\n      senderEmail = item.sender.emailAddress.address || '';\n      senderName = senderName || item.sender.emailAddress.name || '';\n    }\n  }\n\n  const subject = item.subject || '';\n  let description = item.bodyPreview || '';\n  if (!description && item.body && item.body.content) {\n    description = item.body.content.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\\s+/g, ' ').trim();\n  }\n\n  const binary = {};\n  let binaryKeys = [];\n  let hasAttachments = false;\n\n  if (itemData.binary) {\n    let i = 0;\n    for (const key of Object.keys(itemData.binary)) {\n      if (key.startsWith('attachment_')) {\n        const newKey = i === 0 ? 'mediaFiles' : `mediaFiles${i}`;\n        binary[newKey] = itemData.binary[key];\n        binaryKeys.push(newKey);\n        i++;\n      }\n    }\n    if (binaryKeys.length > 0) hasAttachments = true;\n  }\n\n  results.push({\n    json: {\n      fullName: senderName,\n      email: senderEmail,\n      subject: subject,\n      description: description,\n      requestType: 'other',\n      accountType: 'not_collected',\n      source: 'Email',\n      messageId: item.id,\n      hasAttachments: hasAttachments,\n      binaryKeys: binaryKeys.join(',')\n    },\n    binary: hasAttachments ? binary : undefined\n  });\n}\nreturn results;"
      },
